# ── Database ──────────────────────────────────────────────
# SQLite locale (dev): lascia vuoto, usa ./fitos.db
DATABASE_URL=./fitos.db

# ── Auth (NextAuth) ───────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# ── Google OAuth (FREE) ───────────────────────────────────
# 1. console.cloud.google.com → Credenziali → OAuth 2.0
# 2. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple Sign In (opzionale, richiede Apple Dev Account) ─
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── AI Provider (FREE tier) ───────────────────────────────
# Groq: groq.com → API Keys (14.400 req/giorno gratis)
GROQ_API_KEY=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
